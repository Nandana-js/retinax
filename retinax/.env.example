PORT=3000
DB_FILE=./retinax.db
PUBLIC_URL=http://localhost:3000

# AI model: "mock" until the model team delivers, then "http"
MODEL_MODE=http
MODEL_URL=http://127.0.0.1:8000/api/predict
MODEL_API_KEY=

# WhatsApp Cloud API (Meta). Leave empty to run in simulated mode.
WA_PHONE_ID=
WA_TOKEN=
WA_TEMPLATE=            # approved template name (needed to message patients first)
WA_LANG=en

# Email (needs: npm i nodemailer). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RetinaX <no-reply@example.org>
